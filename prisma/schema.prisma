generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(uuid())
  name           String
  email          String            @unique
  passwordHash   String
  settings       Json?
  /// Platform role: user | staff | admin (admin = super admin)
  role           String            @default("user")
  /// active | suspended
  status         String            @default("active")
  staffRoleId    String?
  /// Per-user overrides of the platform default limits
  limits         Json?
  avatarUrl      String?           @db.Text
  bio            String?           @db.Text
  company        String?
  jobTitle       String?
  location       String?
  website        String?
  /// Incremented to revoke every issued token (sign out everywhere, suspension, password change)
  tokenVersion   Int               @default(0)
  lastSeenAt     DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  staffRole      StaffRole?        @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  memberships    WorkspaceMember[]
  projectMembers ProjectMember[]
  history        HistoryItem[]
  cookieJar      CookieJar?
  files          UploadedFile[]
  usage          UsageDaily[]
  devices        SyncDevice[]

  @@index([role])
  @@index([status])
}

/// Staff (employee) role with a set of admin-dashboard permissions.
model StaffRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  permissions Json
  createdAt   DateTime @default(now())
  users       User[]
}

/// Key/value platform configuration (default limits, registration, announcement...).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

/// Daily usage counters per user (requests sent, runs, uploads).
model UsageDaily {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  requests  Int      @default(0)
  runs      Int      @default(0)
  errors    Int      @default(0)
  bytesIn   BigInt   @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model UploadedFile {
  id           String   @id @default(uuid())
  userId       String
  workspaceId  String?
  storedName   String   @unique
  originalName String
  mimeType     String?
  size         Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A client device (browser or desktop app) and its offline-sync state.
model SyncDevice {
  id          String   @id
  userId      String
  platform    String   @default("web")
  appVersion  String?
  pendingOps  Int      @default(0)
  lastSyncAt  DateTime?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Replay protection for offline-queued writes (Idempotency-Key header).
model IdempotencyRecord {
  key        String   @id
  userId     String
  method     String
  path       String   @db.Text
  status     Int
  response   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Workspace {
  id           String            @id @default(uuid())
  name         String
  description  String?           @db.Text
  type         String            @default("personal")
  ownerId      String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  /// Overrides the platform/user limit of members for this workspace
  memberLimit  Int?
  members      WorkspaceMember[]
  projects     Project[]
  collections  Collection[]
  environments Environment[]
  history      HistoryItem[]
  mocks        MockServer[]
  monitors     Monitor[]
  runs         CollectionRun[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    @default("editor")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

/// A project groups collections and environments inside a workspace, with its own invited members.
model Project {
  id           String          @id @default(uuid())
  workspaceId  String
  name         String
  description  String?         @db.Text
  color        String          @default("#FF6C37")
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  collections  Collection[]
  environments Environment[]
}

model ProjectMember {
  id        String  @id @default(uuid())
  projectId String
  userId    String
  role      String  @default("editor")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Collection {
  id               String          @id @default(uuid())
  workspaceId      String
  projectId        String?
  name             String
  description      String?         @db.LongText
  auth             Json?
  variables        Json?
  preRequestScript String?         @db.LongText
  testScript       String?         @db.LongText
  sortOrder        Int             @default(0)
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folders          Folder[]
  requests         Request[]
  mocks            MockServer[]
  monitors         Monitor[]
  runs             CollectionRun[]
}

model Folder {
  id               String     @id @default(uuid())
  collectionId     String
  parentId         String?
  name             String
  description      String?    @db.LongText
  auth             Json?
  preRequestScript String?    @db.LongText
  testScript       String?    @db.LongText
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  collection       Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parent           Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         Folder[]   @relation("FolderTree")
  requests         Request[]
}

model Request {
  id               String     @id @default(uuid())
  collectionId     String
  folderId         String?
  type             String     @default("http")
  name             String
  method           String     @default("GET")
  url              String     @db.Text
  params           Json?
  pathVariables    Json?
  headers          Json?
  body             Json?
  auth             Json?
  preRequestScript String?    @db.LongText
  testScript       String?    @db.LongText
  settings         Json?
  messages         Json?
  description      String?    @db.LongText
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  collection       Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  folder           Folder?    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  examples         Example[]
}

model Example {
  id        String   @id @default(uuid())
  requestId String
  name      String
  request   Json?
  code      Int      @default(200)
  status    String   @default("OK")
  headers   Json?
  body      String?  @db.LongText
  language  String   @default("json")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Environment {
  id          String    @id @default(uuid())
  workspaceId String
  projectId   String?
  /// local | development | production | custom
  stage       String    @default("custom")
  name        String
  isGlobal    Boolean   @default(false)
  variables   Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model HistoryItem {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  method      String
  url         String    @db.Text
  name        String?
  request     Json
  response    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, createdAt])
}

model CookieJar {
  id     String @id @default(uuid())
  userId String @unique
  data   String @db.LongText
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MockServer {
  id            String     @id @default(uuid())
  workspaceId   String
  collectionId  String
  environmentId String?
  name          String
  delay         Int        @default(0)
  isPrivate     Boolean    @default(false)
  apiKey        String?
  createdAt     DateTime   @default(now())
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model Monitor {
  id            String     @id @default(uuid())
  workspaceId   String
  collectionId  String
  environmentId String?
  name          String
  cron          String     @default("0 * * * *")
  enabled       Boolean    @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime   @default(now())
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model CollectionRun {
  id           String     @id @default(uuid())
  workspaceId  String
  collectionId String
  monitorId    String?
  source       String     @default("runner")
  name         String
  stats        Json?
  results      Json?
  createdAt    DateTime   @default(now())
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}
