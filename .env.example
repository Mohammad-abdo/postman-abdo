NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://root:@localhost:3306/fack_postman"
JWT_SECRET="change-me-fack-postman-secret"
JWT_EXPIRES_IN=30d
REDIS_URL="redis://127.0.0.1:6379"
# Comma separated browser origins allowed to call the API (empty = all, dev only)
CORS_ORIGINS="*"
TRUST_PROXY=false
# Block requests to private networks from the hosted executor (SSRF). Defaults to true in production.
BLOCK_PRIVATE_NETWORKS=false
# Super admin created on startup (optional; the first registered user also becomes admin)
ADMIN_EMAIL=abdo@admin.com
ADMIN_PASSWORD=admin123
